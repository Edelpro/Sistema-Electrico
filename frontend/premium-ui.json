{
  "profile": "product-admin",
  "sourceRoots": ["src"],
  "locale": "es-EC",
  "canonicalMap": "UX-CONTRACT.md",
  "requiredCapabilities": ["Select/Listbox", "Date", "Form", "Scrollbar", "CRUD"],
  "ownership": {
    "Select/Listbox": "native",
    "Date": "native"
  },
  "requiredCommands": ["build", "unit", "premium"],
  "commands": {
    "build": "npm run build",
    "unit": "npm test -- --watch=false",
    "premium": "python <frontend-design-premium>/scripts/audit_project.py . --mode strict"
  }
}
